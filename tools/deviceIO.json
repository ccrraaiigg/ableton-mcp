{
    "tools": [
        {
            "name": "deviceIO_functions_summary",
            "description": "Get a summary of the DeviceIO class from the Live Object Model API documentation.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "deviceIO": {
                        "type": "string",
                        "description": "object ID or canonical path of the device IO"
                    }
                },
                "required": [
                    "deviceIO"
                ]
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "summary": {
                        "type": "string",
                        "description": "This class represents an input or output bus of a Live device."
                    }
                }
            }
        },
        {
            "name": "deviceIO_properties_get_availableRoutingChannels",
            "description": "Get the available channels for this input/output bus.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "deviceIO": {
                        "type": "string",
                        "description": "object ID or canonical path of the device IO"
                    }
                },
                "required": [
                    "deviceIO"
                ]
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "availableRoutingChannels": {
                        "type": "object",
                        "properties": {
                            "available_routing_channels": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "display_name": {
                                            "type": "string"
                                        },
                                        "identifier": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        },
                        "description": "available channels for this input/output bus",
                        "readOnly": true,
                        "observable": true
                    }
                }
            }
        },
