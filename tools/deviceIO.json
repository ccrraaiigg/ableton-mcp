                    "routingChannel": {
                        "type": "object",
                        "properties": {
                            "display_name": {
                                "type": "string"
                            },
                            "identifier": {
                                "type": "string"
                            }
                        },
                        "description": "routing channel to set (must be from available_routing_channels)"
                    }
                },
                "required": [
                    "deviceIO",
                    "routingChannel"
