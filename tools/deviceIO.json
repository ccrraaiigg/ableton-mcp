        {
            "name": "deviceIO_properties_set_defaultExternalRoutingChannelIsNone",
            "description": "Set whether the default routing channel for External routing types is none.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "deviceIO": {
                        "type": "string",
                        "description": "object ID or canonical path of the device IO"
                    },
                    "defaultExternalRoutingChannelIsNone": {
                        "type": "boolean",
                        "description": "whether the default routing channel for External routing types is none"
                    }
                },
                "required": [
