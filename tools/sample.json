        {
            "name": "sample_functions_summary",
            "description": "Get a summary of the Sample class from the Live Object Model API documentation.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "sample": {
                        "type": "string",
                        "description": "object ID or canonical path of the sample"
                    }
                },
                "required": [
                    "sample"
                ]
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "summary": {
                        "type": "string",
                        "description": "This class represents a sample file loaded into Simpler. Canonical path: live_set tracks N devices N sample"
                    }
                }
            }
        },
