        {
            "name": "maxDevice_functions_getBankCount",
            "description": "Get the number of parameter banks.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "maxDevice": {
                        "type": "string",
                        "description": "object ID or canonical path of the max device"
                    }
                },
                "required": [
                    "maxDevice"
                ]
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "bankCount": {
                        "type": "integer",
                        "description": "number of parameter banks"
                    }
                }
            }
        },
        {
            "name": "maxDevice_functions_getBankName",
            "description": "Get the name of the parameter bank specified by bank index.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "maxDevice": {
                        "type": "string",
                        "description": "object ID or canonical path of the max device"
                    },
                    "bankIndex": {
                        "type": "integer",
                        "description": "index of the parameter bank"
                    }
                },
                "required": [
                    "maxDevice",
                    "bankIndex"
                ]
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "bankName": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "name of the parameter bank as list of symbols"
                    }
                }
            }
        },
        {
            "name": "maxDevice_functions_getBankParameters",
            "description": "Get the indices of the parameters contained in the bank specified by bank index.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "maxDevice": {
                        "type": "string",
                        "description": "object ID or canonical path of the max device"
                    },
                    "bankIndex": {
                        "type": "integer",
                        "description": "index of the parameter bank (-1 refers to the 'Best of' bank)"
                    }
                },
                "required": [
                    "maxDevice",
                    "bankIndex"
                ]
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "parameterIndices": {
                        "type": "array",
                        "items": {
                            "type": "integer"
                        },
                        "description": "indices of parameters in the bank (empty slots marked as -1)"
                    }
                }
            }
        }
    ]
