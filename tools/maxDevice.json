{
    "tools": [
        {
            "name": "maxDevice_functions_summary",
            "description": "Get a summary of the MaxDevice class from the Live Object Model API documentation.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "maxDevice": {
                        "type": "string",
                        "description": "object ID or canonical path of the max device"
                    }
                },
                "required": [
                    "maxDevice"
                ]
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "summary": {
                        "type": "string",
                        "description": "This class represents a Max for Live device in Live."
                    }
                }
            }
        },
        {
            "name": "maxDevice_properties_get_audioInputs",
