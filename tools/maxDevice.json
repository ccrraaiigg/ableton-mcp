                        "type": "string",
                        "description": "object ID or canonical path of the max device"
                    }
                },
                "required": [
                    "maxDevice"
                ]
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "audioInputs": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "list of audio input device IO IDs",
                        "readOnly": true,
                        "observable": true
                    }
                }
            }
        },
