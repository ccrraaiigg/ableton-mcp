        {
            "name": "simplerDevice_functions_summary",
            "description": "Get a summary of the SimplerDevice class from the Live Object Model API documentation.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "simplerDevice": {
                        "type": "string",
                        "description": "object ID or canonical path of the simpler device"
                    }
                },
                "required": [
                    "simplerDevice"
                ]
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "summary": {
                        "type": "string",
                        "description": "This class represents an instance of Simpler. A SimplerDevice is a type of device, meaning that it has all the children, properties and functions that a device has. Listed below are members unique to SimplerDevice."
                    }
                }
            }
        },
