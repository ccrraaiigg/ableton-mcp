{
    "tools": [
        {
            "name": "compressorDevice_functions_summary",
            "description": "Get a summary of the CompressorDevice class from the Live Object Model API documentation.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "compressorDevice": {
                        "type": "string",
                        "description": "object ID or canonical path of the compressor device"
                    }
                },
                "required": [
                    "compressorDevice"
                ]
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "summary": {
                        "type": "string",
                        "description": "This class represents a Compressor device in Live. A CompressorDevice shares all of the children, functions and properties of a Device; listed below are the members unique to it."
                    }
                }
            }
        },
        {
            "name": "compressorDevice_properties_get_availableInputRoutingChannels",
            "description": "Get the list of available source channels for the compressor's input routing in the sidechain.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "compressorDevice": {
                        "type": "string",
                        "description": "object ID or canonical path of the compressor device"
                    }
                },
                "required": [
                    "compressorDevice"
                ]
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "availableInputRoutingChannels": {
                        "type": "object",
                        "properties": {
                            "available_input_routing_channels": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "display_name": {
                                            "type": "string"
                                        },
                                        "identifier": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        },
                        "description": "dictionary containing list of available input routing channels",
                        "readOnly": true,
                        "observable": true
                    }
                }
            }
        },
        {
            "name": "compressorDevice_properties_get_availableInputRoutingTypes",
