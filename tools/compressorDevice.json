                "type": "object",
                "properties": {
                    "compressorDevice": {
                        "type": "string",
                        "description": "object ID or canonical path of the compressor device"
                    }
                },
                "required": [
                    "compressorDevice"
                ]
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "availableInputRoutingTypes": {
                        "type": "object",
                        "properties": {
                            "available_input_routing_types": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "display_name": {
                                            "type": "string"
                                        },
                                        "identifier": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        },
                        "description": "dictionary containing list of available input routing types",
                        "readOnly": true,
                        "observable": true
                    }
                }
            }
        },
        {
            "name": "compressorDevice_properties_get_inputRoutingChannel",
            "description": "Get the currently selected source channel for the compressor's input routing in the sidechain.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "compressorDevice": {
                        "type": "string",
                        "description": "object ID or canonical path of the compressor device"
                    }
                },
                "required": [
                    "compressorDevice"
                ]
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "inputRoutingChannel": {
                        "type": "object",
                        "properties": {
                            "display_name": {
                                "type": "string"
                            },
                            "identifier": {
                                "type": "string"
                            }
                        },
                        "description": "currently selected source channel for sidechain input routing",
                        "readOnly": false,
                        "observable": true
                    }
                }
            }
        },
        {
            "name": "compressorDevice_properties_get_inputRoutingType",
            "description": "Get the currently selected source type for the compressor's input routing in the sidechain.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "compressorDevice": {
                        "type": "string",
