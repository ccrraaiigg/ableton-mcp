                    }
                },
                "required": [
                    "compressorDevice"
                ]
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "inputRoutingType": {
                        "type": "object",
                        "properties": {
                            "display_name": {
                                "type": "string"
                            },
                            "identifier": {
                                "type": "string"
                            }
                        },
                        "description": "currently selected source type for sidechain input routing",
                        "readOnly": false,
