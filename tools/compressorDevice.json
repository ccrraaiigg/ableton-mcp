        {
            "name": "compressorDevice_properties_set_inputRoutingChannel",
            "description": "Set the source channel for the compressor's input routing in the sidechain.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "compressorDevice": {
                        "type": "string",
                        "description": "object ID or canonical path of the compressor device"
                    },
                    "inputRoutingChannel": {
                        "type": "object",
                        "properties": {
                            "display_name": {
                                "type": "string"
                            },
                            "identifier": {
                                "type": "string"
                            }
                        },
                        "description": "source channel configuration (must be from available_input_routing_channels)"
                    }
                },
                "required": [
                    "compressorDevice",
                    "inputRoutingChannel"
                ]
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "success": {
                        "type": "boolean",
                        "description": "whether the operation was successful"
                    }
                }
            }
        },
        {
            "name": "compressorDevice_properties_set_inputRoutingType",
