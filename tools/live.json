{
    "tools": [
        {
            "name": "live_get_child_attributes",
            "description": "Get the read-only and observable attributes for a specific child of any Ableton Live object.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "objectId": {
                        "type": "string",
                        "description": "object ID of the parent object"
                    },
                    "childName": {
                        "type": "string",
                        "description": "name of the child to query"
                    }
                },
                "required": [
                    "objectId",
                    "childName"
                ]
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "childName": {
                        "type": "string",
                        "description": "name of the child"
                    },
                    "exists": {
                        "type": "boolean",
                        "description": "whether the child exists"
                    },
                    "readOnly": {
                        "type": "boolean",
                        "description": "whether the child is read-only"
                    },
                    "observable": {
                        "type": "boolean",
                        "description": "whether the child is observable"
                    }
                }
            }
        },
        {
            "name": "live_get_class_children",
            "description": "Get all child names defined by a given Ableton Live class (specified by name).",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "className": {
                        "type": "string",
                        "description": "name of the class to query"
                    }
                },
                "required": [
                    "className"
                ]
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "className": {
                        "type": "string",
                        "description": "name of the class"
                    },
                    "children": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "list of child names defined by the class"
                    },
                    "exists": {
                        "type": "boolean",
                        "description": "whether the class exists"
                    }
                }
            }
        },
