{
    "tools": [
        {
            "name": "deviceParameter_functions_summary",
            "description": "Get a summary of the DeviceParameter class from the Live Object Model API documentation.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "deviceParameter": {
                        "type": "string",
                        "description": "object ID or canonical path of the device parameter"
                    }
                },
                "required": [
                    "deviceParameter"
                ]
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "summary": {
                        "type": "string",
                        "description": "This class represents an (automatable) parameter within a MIDI or audio device. To modify a device parameter, set its value property or send its object ID to live.remote~. Canonical path: live_set tracks N devices M parameters L"
                    }
                }
            }
        },
        {
            "name": "deviceParameter_properties_get_automationState",
