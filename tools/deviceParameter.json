            "outputSchema": {
                "type": "object",
                "properties": {
                    "automationState": {
                        "type": "integer",
                        "description": "automation state (0=no automation, 1=automation active, 2=automation overridden)",
                        "readOnly": true,
                        "observable": true
                    }
                }
            }
        },
