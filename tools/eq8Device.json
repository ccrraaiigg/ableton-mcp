            "type": "boolean",
            "description": "edit mode state - in L/R mode: 0 = L, 1 = R; in M/S mode: 0 = M, 1 = S; in Stereo mode: 0 = A, 1 = B (inactive)"
          }
        },
        "required": ["device", "editMode"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
