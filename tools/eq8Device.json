    {
      "name": "eq8Device_properties_get_editMode",
      "description": "Get EQ Eight's edit mode, which toggles the channel currently available for editing.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "device": {
            "type": "string",
            "description": "unique identifier for the Eq8Device object"
          }
        },
        "required": ["device"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "editMode": {
            "type": "boolean",
            "description": "edit mode state - in L/R mode: 0 = L, 1 = R; in M/S mode: 0 = M, 1 = S; in Stereo mode: 0 = A, 1 = B (inactive)"
          },
          "readOnly": {
            "type": "boolean",
            "description": "false"
          },
          "observable": {
            "type": "boolean", 
            "description": "true"
          }
        }
      }
    },
