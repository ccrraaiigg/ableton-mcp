            "name": "wavetableDevice_functions_summary",
            "description": "Get a summary of the WavetableDevice class from the Live Object Model API documentation.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "device": {
                        "type": "string",
                        "description": "object ID or canonical path of the wavetable device"
                    }
                },
                "required": [
                    "device"
                ]
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "summary": {
                        "type": "string",
                        "description": "This class represents a Wavetable instrument."
