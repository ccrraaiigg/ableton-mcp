        {
            "name": "scene_functions_fire",
            "description": "Fire all clip slots contained within the scene and select this scene.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "scene": {
                        "type": "string",
                        "description": "object ID or canonical path of the scene"
                    },
                    "forceLegato": {
                        "type": "boolean",
                        "description": "whether to launch all clips immediately in Legato",
                        "default": false
                    },
                    "canSelectSceneOnLaunch": {
                        "type": "boolean",
                        "description": "whether the scene should be selected when fired",
                        "default": true
                    }
                },
                "required": [
                    "scene"
                ]
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "success": {
                        "type": "boolean",
                        "description": "whether scene was fired successfully"
                    }
                }
            }
        },
