            "name": "scene_functions_summary",
            "description": "Get a summary of the Scene class from the Live Object Model API documentation.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "scene": {
                        "type": "string",
                        "description": "object ID or canonical path of the scene"
                    }
                },
                "required": [
                    "scene"
                ]
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "summary": {
                        "type": "string",
                        "description": "This class represents a series of clip slots in Live's Session View matrix. Canonical path: live_set scenes N"
                    }
                }
            }
        },
