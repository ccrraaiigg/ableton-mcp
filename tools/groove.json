{
    "tools": [
        {
            "name": "groove_functions_summary",
            "description": "Get a summary of the Groove class from the Live Object Model API documentation.",
            "inputSchema": {
                "type": "object",
                "properties": {},
                "required": []
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "summary": {
                        "type": "string",
                        "description": "This class represents a groove in Live. Available since Live 11.0. All grooves are stored in Live's groove pool. Canonical paths: live_set groove_pool grooves N or live_set tracks N clip_slots M clip groove"
                    }
                }
            }
        },
        {
            "name": "groove_properties_get_base",
            "description": "Get the groove's base grid (index based).",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "groove": {
                        "type": "string",
                        "description": "ID of the groove object"
                    }
                },
                "required": [
                    "groove"
                ]
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "base": {
                        "type": "integer",
                        "description": "base grid index (0=1/4, 1=1/8, 2=1/8T, 3=1/16, 4=1/16T, 5=1/32)"
                    }
                }
            }
        },
        {
            "name": "groove_properties_set_base",
            "description": "Set the groove's base grid (index based).",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "groove": {
                        "type": "string",
                        "description": "ID of the groove object"
                    },
                    "base": {
                        "type": "integer",
                        "description": "base grid index (0=1/4, 1=1/8, 2=1/8T, 3=1/16, 4=1/16T, 5=1/32)",
                        "minimum": 0,
                        "maximum": 5
                    }
                },
                "required": [
                    "groove",
                    "base"
                ]
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "success": {
                        "type": "boolean",
                        "description": "whether the base grid was set successfully"
                    }
                }
            }
        },
