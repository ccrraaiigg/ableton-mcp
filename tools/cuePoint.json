{
    "tools": [
        {
            "name": "cuePoint_properties_get_name",
            "description": "Get the name of the cue point.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "cuePoint": {
                        "type": "string",
                        "description": "ID of the cue point object"
                    }
                },
                "required": [
                    "cuePoint"
                ]
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "name of the cue point",
                        "observable": true
                    }
                }
            }
        },
        {
            "name": "cuePoint_properties_set_name",
            "description": "Set the name of the cue point.",
