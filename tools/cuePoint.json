            "inputSchema": {
                "type": "object",
                "properties": {
                    "cuePoint": {
                        "type": "string",
                        "description": "ID of the cue point object"
                    }
                },
                "required": [
                    "cuePoint"
                ]
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "time": {
                        "type": "number",
