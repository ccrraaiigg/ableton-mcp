                "type": "object",
                "properties": {
                    "cuePoint": {
                        "type": "string",
                        "description": "ID of the cue point object"
                    },
                    "name": {
                        "type": "string",
                        "description": "new name for the cue point"
                    }
                },
                "required": [
                    "cuePoint",
                    "name"
                ]
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "success": {
                        "type": "boolean",
                        "description": "whether the name was set successfully"
                    }
                }
            }
        },
        {
            "name": "cuePoint_properties_get_time",
