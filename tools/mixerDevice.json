{
    "tools": [
        {
            "name": "mixerDevice_functions_summary",
            "description": "Get a summary of the MixerDevice class from the Live Object Model API documentation.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "mixerDevice": {
                        "type": "string",
                        "description": "object ID or canonical path of the mixer device"
                    }
                },
                "required": [
                    "mixerDevice"
                ]
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "summary": {
                        "type": "string",
                        "description": "This class represents a mixer device in Live. It provides access to volume, panning and other DeviceParameter objects. Canonical path: live_set tracks N mixer_device"
                    }
                }
            }
        },
