{
    "tools": [
        {
            "name": "rackDevice_functions_summary",
            "description": "Get a summary of the RackDevice class from the Live Object Model API documentation.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "rackDevice": {
                        "type": "string",
                        "description": "object ID or canonical path of the rack device"
                    }
                },
                "required": [
                    "rackDevice"
                ]
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "summary": {
                        "type": "string",
                        "description": "This class represents a Live Rack Device. A RackDevice is a type of Device, meaning that it has all the children, properties and functions that a Device has."
                    }
                }
            }
        },
        {
