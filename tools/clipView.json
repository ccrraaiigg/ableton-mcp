{
    "tools": [
        {
            "name": "clipView_functions_summary",
            "description": "Get a summary of the Clip.View class from the Live Object Model API documentation.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "clipView": {
                        "type": "string",
                        "description": "object ID or canonical path of the clip view"
                    }
                },
                "required": [
                    "clipView"
                ]
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "summary": {
                        "type": "string",
                        "description": "Representing the view aspects of a Clip. Canonical path: live_set tracks N clip_slots M clip view"
                    }
                }
            }
        },
