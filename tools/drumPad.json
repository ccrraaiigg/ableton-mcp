{
    "tools": [
        {
            "name": "drumPad_children_get_chains",
            "description": "Get all chains in the drum pad.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "drumPad": {
                        "type": "string",
                        "description": "iD of the drum pad"
                    }
                },
                "required": [
                    "drumPad"
                ]
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "chains": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "list of chain IDs",
                        "readOnly": true,
                        "observable": true
                    }
                }
            }
        },
