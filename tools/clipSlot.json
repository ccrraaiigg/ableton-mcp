        {
            "name": "clipSlot_functions_createAudioClip",
            "description": "Create an audio clip from a file path in this clip slot.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "clipSlot": {
                        "type": "string",
                        "description": "object ID or canonical path of the clip slot"
                    },
                    "path": {
                        "type": "string",
                        "description": "absolute path to a valid audio file in a supported format"
                    }
                },
                "required": [
                    "clipSlot",
                    "path"
                ]
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "success": {
                        "type": "boolean",
                        "description": "whether audio clip was created successfully"
                    }
                }
            }
        },
        {
            "name": "clipSlot_functions_createClip",
            "description": "Create a MIDI clip with specified length in this empty clip slot.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "clipSlot": {
                        "type": "string",
                        "description": "object ID or canonical path of the clip slot"
                    },
                    "length": {
                        "type": "number",
                        "description": "length in beats, must be greater than 0.0"
                    }
                },
                "required": [
                    "clipSlot",
                    "length"
                ]
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "success": {
                        "type": "boolean",
                        "description": "whether MIDI clip was created successfully"
                    }
                }
            }
        },
