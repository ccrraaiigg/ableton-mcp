                }
            }
        },
        {
            "name": "clipSlot_functions_duplicateClipTo",
            "description": "Duplicate this slot's clip to the given target clip slot.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "clipSlot": {
                        "type": "string",
                        "description": "object ID or canonical path of the source clip slot"
                    },
                    "targetClipSlot": {
                        "type": "string",
                        "description": "object ID or canonical path of the target clip slot"
                    }
                },
                "required": [
                    "clipSlot",
                    "targetClipSlot"
                ]
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "success": {
                        "type": "boolean",
                        "description": "whether clip was duplicated successfully"
                    }
                }
            }
        },
        {
            "name": "clipSlot_functions_fire",
            "description": "Fire the clip, trigger the Stop Button, or start recording if slot is empty and track is armed.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "clipSlot": {
                        "type": "string",
                        "description": "object ID or canonical path of the clip slot"
                    },
                    "recordLength": {
                        "type": "number",
                        "description": "optional recording length in beats"
                    },
                    "launchQuantization": {
                        "type": "integer",
                        "description": "optional launch quantization override"
                    }
                },
                "required": [
                    "clipSlot"
                ]
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "success": {
                        "type": "boolean",
                        "description": "whether clip slot was fired successfully"
                    }
                }
            }
        },
