{
    "tools": [
        {
            "name": "clipSlot_functions_summary",
            "description": "Get a summary of the ClipSlot class from the Live Object Model API documentation.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "clipSlot": {
                        "type": "string",
                        "description": "object ID or canonical path of the clip slot"
                    }
                },
                "required": [
                    "clipSlot"
                ]
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "summary": {
                        "type": "string",
                        "description": "This class represents an entry in Live's Session View matrix. Canonical path: live_set tracks N clip_slots M"
                    }
                }
            }
        },
        {
